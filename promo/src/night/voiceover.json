  "lines": [
    {
      "id": "vo01",
      "from": 8,
      "voice": "narrator",
      "text": "Tanggal dua puluh lima. Gajian!"
    },
    {
      "id": "vo02",
      "from": 104,
      "voice": "narrator",
      "text": "Tapi, tanggal lima belas... kok udah abis?"
    },
    {
      "id": "vo03",
      "from": 178,
      "voice": "narrator",
      "text": "Bukan gajinya yang kurang."
    },
    {
      "id": "vo04",
      "from": 238,
      "voice": "narrator",
      "text": "Kamu cuma belum tahu jatahnya."
    },
    {
      "id": "vo05",
      "from": 318,
      "voice": "narrator",
      "text": "Kenalin, Sangu."
    },
    {
      "id": "vo06",
      "from": 400,
      "voice": "narrator",
      "text": "Sangu ngitung jatah aman kamu, tiap hari."
    },
    {
      "id": "vo07",
      "from": 563,
      "voice": "user",
      "text": "Ehem… beli kopi susu dua puluh delapan ribu pakai GoPay, terus… bayar parkir tiga ribu pakai cash.",
      "style": "Ucapkan dalam bahasa Indonesia, santai dan natural seperti orang yang sedang bicara ke HP untuk mencatat pengeluaran. Awali dengan berdeham pelan (\"ehem\"). Setelah kata \"terus\", berhenti sebentar dan hela napas panjang dengan sedikit kesal (semua orang malas bayar parkir), lalu lanjutkan dengan nada pasrah. Jangan tambahkan kata apa pun:"
    },
    {
      "id": "vo08",
      "from": 801,
      "voice": "narrator",
      "text": "Cukup ngomong."
    },
    {
      "id": "vo09",
      "from": 865,
      "voice": "narrator",
      "text": "Foto nota, atau screenshot bukti bayar. Langsung kebaca."
    },
    {
      "id": "vo10",
      "from": 1010,
      "voice": "narrator",
      "text": "Bayar seperti biasa."
    },
    {
      "id": "vo11",
      "from": 1130,
      "voice": "narrator",
      "text": "Notif masuk, tinggal simpan."
    },
    {
      "id": "vo12",
      "from": 1305,
      "voice": "narrator",
      "text": "Semua rapi, otomatis."
    },
    {
      "id": "vo13",
      "from": 1433,
      "voice": "narrator",
      "text": "Tanpa login. Tanpa akun."
    },
    {
      "id": "vo14",
      "from": 1523,
      "voice": "narrator",
      "text": "Datamu cuma di HP kamu."
    },
    {
      "id": "vo15",
      "from": 1623,
      "voice": "narrator",
      "text": "Sangu. Tenang sampai gajian."
    }
  ]
}
